<style>


    .card {
      position: relative;
      overflow: hidden;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease;
    }

    .card:hover {
      transform: scale(1.05);
    }

    .card img {
      width: 100%;
      height: 350px;
      display: block;
      object-fit: cover;
    }

    .col-sm-5 {
      animation: slideIn 2s ease-out;
    }

@@keyframes slideIn {
      from {
        transform: translateX(-100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    .card {
      animation: slideIn 3s ease-out;
    }

    #c2{
        margin-left: 100px;
      }
      #c1{
        margin-right: 100px;
      }


@@keyframes slideIn {
      from {
        transform: translateX(-100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    .card .name {
        text-align: center;
        padding: 10px;
        background-color: #fff;
        font-size: 18px;
        font-weight: bold;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items:  center;
    }

    .social-icons {
      position: absolute;
      top: 50%;
      left: -50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: left 0.5s ease;
    }

    .card:hover .social-icons {
      left: 10px;
    }

    .card2:hover .social-icons {
      right: 10px;
    }

    .social-icons a {
      color: white;
      background: #333;
      padding: 10px;
      border-radius: 50%;
      text-align: center;
      font-size: 16px;
      width: 40px;
      height: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      text-decoration: none;
      transition: background 0.3s ease;
    }

    .social-icons a:hover {
      background: maroon;
    }

    .col-sm-5 {
      padding: 20px;
    }

    .col-sm-5 h2 {
      font-size: 24px;
      margin-bottom: 15px;
      color: #333;
    }

    .col-sm-5 p {
      font-size: 15px;
      color: #555;
      margin-bottom: 10px;
    }

    .info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .info p {
      margin: 0;
    }

@@media (max-width: 576px) {
      .card {
        margin: 0px;
        padding: 0px;
      }
      .card img {
        margin: 0px;
        padding: 0px;
      }
      #c2{
        margin: 0px;
      }
      #c1{
        margin-right: 0px;
      }
      .info {
        flex-direction: column;
        /* align-items: center; */
      }

      .info p {
        margin-bottom: 5px;
      }
    }
@@media (max-width: 768px) {
  .row {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #c2 {
    margin-bottom: 20px;
  }

  .col-sm-5, .col-sm-4 {
    width: 100%;
  }

  .col-sm-5 {
    order: 2; /* Details ko niche laane ke liye */
  }

  .col-sm-4 {
    order: 1; /* Image ko upar le jaane ke liye */
  }

  .card img {
    max-width: 100%;
    height: auto;
    margin-bottom: 15px;
  }

  .info {
    justify-content: center;
  }
}

