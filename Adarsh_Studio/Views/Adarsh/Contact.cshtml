
@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}

<style>
    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        border-radius: 10px;
        transition: all 0.3s ease-in-out;
        margin: 10px;
        text-decoration: none;
        color: inherit;
        min-height: 250px; /* Equal height for all cards */
    }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 12px rgba(0, 0, 0, 0.3);
            background-color: #f8f9fa; /* Subtle background color change on hover */
        }

    .icon {
        font-size: 3rem;
        color: black;
        margin-bottom: 15px;
        transition: color 0.3s ease-in-out;
    }

    .card:hover .icon {
        color: rgb(154, 31, 31); /* Color change on hover */
    }

    .card h5 {
        margin-top: 10px;
        margin-bottom: 5px;
    }

    .card p {
        margin-bottom: 0;
        color: #6c757d;
    }

   

    
    .bg-video {
        width: 100%;
        height: 100%; /* Ensuring video fits the container */
        object-fit: cover; /* Covers the full width and height */
    }

    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.6); /* White overlay with 90% opacity */
        z-index: 1;
    }

    .text-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #d45757;
        text-align: center;
        z-index: 2;
        font-family: 'Montserrat', sans-serif;
        text-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        animation: fadeIn 2s ease-in-out, blink 1.5s infinite; /* Added blinking animation */
    }

        .text-overlay h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .text-overlay p {
            font-size: 1.5rem;
            font-weight: 500;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translate(-50%, -60%);
        }

        to {
            opacity: 1;
            transform: translate(-50%, -50%);
        }
    }

    @@keyframes blink {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            opacity: 1;
        }
    }


    .conP {
        text-align: center;
    }

    .contact-container {
        max-width: 1200px;
        padding: 2rem;
        border-radius: 10px;
    }

    .contact-header {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .contact-subtext {
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 1.5rem;
    }



    .info-box {
        background: white;
        margin-top: 50px;
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15), 0 -4px 10px rgba(0, 0, 0, 0.1), -4px 0 10px rgba(0, 0, 0, 0.1), 4px 0 10px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .info-box a {
            text-decoration: none;
            color: black;
        }

        .info-box:hover {
            background-color: maroon;
            color: white;
        }

            .info-box:hover a {
                color: white;
            }

        .info-box i {
            margin-right: 0.5rem;
            font-size: 1.5rem;
        }

    .social-icon {
        display: inline;
        justify-content: space-around;
        margin-top: 1rem;
        color: black;
    }

        .social-icon a {
            font-size: 1.5rem;
            color: black;
            text-decoration: none;
            margin: 0 0.5rem;
        }

            .social-icon a:hover {
                color: maroon;
            }
    /* ===========================Map styling=================== */
    .map-container {
        position: relative;
        padding-bottom: 40.25%; /* 16:9 aspect ratio */
        /* height: 0px; */
        overflow: hidden;
        max-width: 100%;
        margin-top: 20px;
    }

        .map-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 500px;
        }

    /* Custom styles for the background image and overlay */
    .services-background {
        background-image: url('/gallery/contacttop.webp'); /* Replace with your image URL */
        background-size: cover;
        background-position: center;
        position: relative;
        height: 300px; /* Adjust as needed */
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Black with 50% opacity */
    }

    .services-heading {
        position: relative;
        z-index: 1; /* Ensures the heading is above the overlay */
        color: #fff;
        text-align: center;
        padding-top: 100px; /* Adjust padding to center the heading */
    }

    .image-container {
        position: relative;
       
    }

    .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.5s ease;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Transparent black */
        opacity: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: opacity 0.5s ease;
    }

    .image-container:hover .overlay {
        opacity: 1;
    }

    .text {
        color: white;
        font-size: 20px;
        text-align: center;
    }


    </style>

