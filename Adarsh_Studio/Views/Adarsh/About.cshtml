                        <h5>Illustration</h5>
                        <p>Our custom illustrations bring your brand's message to life with vibrant and engaging visuals.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-1"></div>
    </div>

    <!--next row-->
    <!-- Motion Graphics Card -->
    <div class="row">
        <div class="col-sm-1"></div>
        <div class="col-sm-10">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="expertise-card expertise-card-illustration border border-danger shadow-lg">
                        <i class="fas fa-video"></i>
                        <h5>Motion Graphics</h5>
                        <p>We create dynamic visuals and animations that help tell your brand's story in a memorable way.</p>
                    </div>
                </div>

                <!-- Photography Card -->
                <div class="col-md-4 mb-4">
                    <div class="expertise-card expertise-card-illustration border border-danger shadow-lg">
                        <i class="fas fa-camera-retro"></i>
                        <h5>Photography</h5>
                        <p>Our professional photography captures the essence of your brand through stunning visuals.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="expertise-card expertise-card-illustration border border-danger shadow-lg">
                        <i class="fas fa-video"></i>
                        <h5>Motion Graphics</h5>
                        <p>We create dynamic visuals and animations that help tell your brand's story in a memorable way.</p>
                    </div>
                </div>
            </div>
