<div class="container-fluid">   
    <div class="row">       
        <div class="col text-center mb-3">  
        <h1 class="my-4" style="font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif"></h1>    
        <div class="btn-group" role="group" aria-label="Category buttons">               
            <button type="button" class="btn btn-primary" onclick="filterCategory('Events')" aria-label="Pre-wedding">All Events</button>       
            <button type="button" class="btn btn-primary" onclick="filterCategory('Prewedding')" aria-label="Birthday Party">Pre Wedding</button>            
            <button type="button" class="btn btn-primary" onclick="filterCategory('Wedding')" aria-label="Candid Photography">Weddings</button>            
            <button type="button" class="btn btn-primary" onclick="filterCategory('Candid')" aria-label="Ceremony">Candid Shoots</button>         
            <button type="button" class="btn btn-primary" onclick="filterCategory('Ceremony')" aria-label="Events">Ceremony</button>      
        </div>      
        </div> 
        </div>      
              <!-- Gallery Section -->    

              <div id="gallery" class="row gallery-container" style="display: none;"> 
                  <!-- Gallery images will be displayed here -->  
                  </div> 
                  </div>



<script>
    const images = {
        Events: [
            '/gallery/bride2.jpg',
            '/gallery/wed5.jpg',
            '/gallery/nightcouple.jpg',
            '/gallery/bride3.jpg',
            '/gallery/bride4.jpg',
            '/gallery/wed3.jpg'
        ],
        Prewedding: [
            '/gallery/prewed.png',
            '/gallery/couple3.jpg',
            '/gallery/prewed1.png',
            '/gallery/couple.jpg',
            '/gallery/couple2.jpg'
        ],
        Wedding: [
            '/gallery/wed1.jpg',
            '/gallery/broomwed.png',
            '/gallery/wedcouple.jpeg',
            '/gallery/bride6.jpg',
            '/gallery/wed4.jpg',
            '/gallery/bride5.jpg'
        ],
        Candid: [
            '/gallery/girlshd.jpg',
            '/gallery/prewed2.jpg',
            '/gallery/bride4.jpg',
            '/gallery/services2.jpeg'
        ],
        Ceremony: [
            '/gallery/ceremony3.jpg',
            '/gallery/haldicollage.jpg',
            '/gallery/mehendipose.jpg',
            '/gallery/Haldi4.jpg',
            '/gallery/mehendi1.jpg'
        ]
    };

    function filterCategory(category) {
        const galleryContainer = document.getElementById('gallery');

        // Fade out the current gallery
        $(galleryContainer).fadeOut(300, function() {
            galleryContainer.innerHTML = ''; // Clear the current images

            // Add new images for the selected category
            images[category].forEach(image => {
                const div = document.createElement('div');
                div.classList.add('col-md-4', 'gallery-item', 'mb-3');
                div.innerHTML = `<img src="${image}" alt="${category}" class="img-fluid rounded">`;
                galleryContainer.appendChild(div);
            });

            // Fade in the updated gallery
            $(galleryContainer).fadeIn(300);
        });
    }

    // Default to show nature images
    window.onload = function() {
        filterCategory('Events');
    };
</script>

       

   