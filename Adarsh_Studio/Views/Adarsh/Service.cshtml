}

@model IEnumerable<Adarsh_Studio.Models.ServiceMaster>

<style>


    .hero-section {
        position: relative;
        height: 400px;
        background: url('/gallery/indexslider2.jpg') center/cover no-repeat;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 90%;
        max-width: 800px;
    }

    .hero-text {
        font-size: 5.5rem;
        font-family: 'Times New Roman', serif;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

    .p-text {
        font-size: 1.4rem;
        font-family: 'Times New Roman', serif;
        white-space: normal; /* ✅ Line Breaks will work */
        overflow: hidden;
        border-right: 2px solid white;
        max-width: 100%;
    }

    .show-text {
        opacity: 1;
    }

    /* ✅ Responsive Fixes */
    @@media (max-width: 768px) {
        .hero-text {
            font-size: 3rem;
        }

        .p-text {
            font-size: 1rem;
            letter-spacing: 0.5px;
        }
    }
    /* ================== */
    .feature-section {
        padding: 50px 0;
        margin-top: 50px;
    }

    .feature-box {
        text-align: center;
        margin-bottom: 30px;
    }

        .feature-box i {
            font-size: 50px;
            margin-bottom: 10px;
            color: #000; /* Dark color for better visibility */
        }

        .feature-box h5 {
            /* font-weight: 600; */
            font-size: 30px;
        }

    @@media (max-width: 768px) {
        /* Feature box icon size for mobile */
        .feature-box i {
            font-size: 40px; /* Smaller icon size */
        }
        /* Feature box heading font size for mobile */
        .feature-box h5 {
            font-size: 20px; /* Slightly smaller heading */
        }
        /* Make the feature boxes stack vertically */
        .feature-box {
            margin-bottom: 20px; /* Space between the stacked boxes */
        }
        /* Adjust the columns to take full width */
        .col-md-3, .col-6 {
            width: 100%; /* Each box takes full width on mobile */
        }
    }


    /* ========Wedding Cards======= */

    .card-details-section {
        margin-top: 40px;
    }

        .card-details-section h3 {
            text-align: center;
            margin-bottom: 30px;
        }

        .card-details-section p {
            font-size: 1rem;
            line-height: 1.5;
            text-align: justify;
        }

    .image-card {
        width: 100%;
        height: 500px; /* Fixed height */
        border: 2px solid #ddd;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

        .image-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-details {
        padding: 20px;
    }

    .thumbnail-slider {
        display: flex;
        overflow-x: auto;
        margin-top: 20px;
        justify-content: start;
        position: relative;
        scroll-behavior: smooth;
    }

        .thumbnail-slider img {
            width: 100px;
            height: 100px;
            margin: 0 10px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: transform 0.3s, border-color 0.3s;
        }

            .thumbnail-slider img:hover {
                transform: scale(1.1);
                border-color: #007bff;
            }

        .thumbnail-slider::-webkit-scrollbar {
            display: none;
        }

    .slider-controls {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
    }

        .slider-controls button {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .slider-controls button:hover {
                background-color: #0056b3;
            }

    @@media (max-width: 768px) {
        /* Stack content vertically */
        /* Ensure the image card takes full width on mobile */
        .image-card {
            width: 100%;
            height: 250px; /* Reduced height for mobile */
            margin-bottom: 20px; /* Space below the image card */
        }
        /* Thumbnail slider should take full width */
        .thumbnail-slider {
            width: 100%;
            margin-bottom: 20px; /* Space below the slider */
        }
            /* Make thumbnail images smaller for mobile */
            .thumbnail-slider img {
                width: 80px;
                height: 60px;
                margin: 0 8px;
            }
        /* Move content below the slider */
        .card-details {
            width: 100%;
            padding: 10px;
            font-size: 14px;
        }

            .card-details h3 {
                font-size: 20px; /* Smaller heading for mobile */
                margin-bottom: 15px; /* Space below the heading */
            }

            .card-details ul {
                list-style-type: none;
                padding-left: 0;
            }

                .card-details ul li {
                    font-size: 13px;
                    line-height: 1.5;
                }
        /* Center the controls */
        .slider-controls {
            text-align: center;
        }
            /* Optional: Adjust the button size for better visibility */
            .slider-controls button {
                padding: 8px 15px;
                font-size: 14px;
            }
    }

    /* =========lIVE STRIMING========== */

    .live-streaming-section {
        padding: 50px 0;
        background-color: #ffffff;
    }
    /* Default Aspect Ratio for Desktop */
    .video-container {
        position: relative;
        padding-top: 56.25%;
        overflow: hidden;
        border-radius: 10px;
        margin-bottom: 30px;
    }


        .video-container video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

    .live-content {
        padding: 20px;
        /* background-color: #f1f1f1; */
        border-radius: 10px;
    }

        .live-content h3 {
            font-size: 28px;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .live-content ul {
            list-style-type: none;
            padding-left: 0;
        }

            .live-content ul li {
                font-size: 16px;
                line-height: 1.6;
                margin-bottom: 15px;
            }
    /* Style for Heading and Description */
    .section-heading {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }

    .section-description {
        font-size: 18px;
        line-height: 1.8;
        color: #555;
        /* max-width: 800px; */
        margin: 0 auto;
        text-align: center;
        padding: 0 15px;
    }


    /* Mobile Adjustments (for smaller screens) */
    @@media (max-width: 768px) {
        /* Adjusting Aspect Ratio for Mobile Devices */
        .video-container {
            padding-top: 75%; /* 4:3 aspect ratio for mobile */
        }

        .live-content h3 {
            font-size: 22px; /* Smaller font size for mobile */
        }

        .live-content ul li {
            font-size: 14px; /* Adjusting font size for mobile */
        }

        .col-sm-6 {
            margin-bottom: 20px; /* Add some margin between columns */
        }
    }

    /* Album desiging==== */
    .album-bg {
