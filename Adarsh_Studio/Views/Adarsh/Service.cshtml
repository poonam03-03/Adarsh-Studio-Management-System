    /* Fix Bootstrap container causing overflow */


    /*Dynamic Slider*/
    .carousel-item {
        height: 400px; /* Adjust the height as per your design */
        background-color: #f5f5f5; /* Light background color */
    }

        .carousel-item img {
            object-fit: cover;
            height: 100%;
            width: 100%;
        }

        .carousel-item .text-center {
            font-size: 1.2rem;
        }

</style>
















<div class="container-fluid hero-section">
    <div class="overlay"></div>
    <div class="hero-content">
        <h1 class="hero-text">Our Services</h1>
        <p class="p-text"></p>
    </div>
</div>

<script>
    $(document).ready(function() {
        setTimeout(function() {
            $(".hero-text").addClass("show-text");
        }, 500);

        let text = "Adarsh Studio offers card printing, album designing, photography, videography, live streaming,<br> wall TV poster printing, and pre-wedding shoots.";
        let i = 0;
        let displayText = "";

        function typeWriter() {
            if (i < text.length) {
                if (text.substring(i, i + 4) === "<br>") {
                    displayText += "<br>";
                    i += 4;
                } else {
                    displayText += text.charAt(i);
                    i++;
                }
                $(".p-text").html(displayText);
                setTimeout(typeWriter, 40);
            } else {
                $(".p-text").css("border-right", "none");
            }
        }

        setTimeout(typeWriter, 1500);
    });


</script>



<div class="container mt-5">
    <h1 class="text-center mb-4" style="color:#a33838"> Our Services</h1>

    <!-- Carousel -->
    <div id="serviceCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @foreach (var service in Model)
            {
                <div class="carousel-item @((Model.First() == service) ? "active" : "")">
                    <div class="row g-0">
                        <!-- Service Details (Left Column) -->
                        <div class="col-md-6 d-flex align-items-center justify-content-center bg-light">
                            <div class="text-center p-4">
                                <h4>@service.ServiceType</h4>
                                <p>@service.Category</p>
                                <p>@service.Description</p>
                                <p class="fw-bold">Budget: @service.Budget</p>
                            </div>
                        </div>

                        <!-- Service Image (Right Column) -->
                        <div class="col-md-6">
                            @foreach (var pic in service.ServicePicMasters)
                            {
                                <img src="@Url.Content("~/uploads/" + "/" + pic.PicFileName)" class="d-block w-100" alt="Service Image" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Carousel Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#serviceCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#serviceCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>


