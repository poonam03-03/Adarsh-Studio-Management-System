<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
      // Change main image on thumbnail click
      $('.thumbnail-slider img').on('click', function () {
        const src = $(this).attr('src');
        const mainImage = $('#main-image');
        mainImage.fadeOut(300, function () {
          mainImage.attr('src', src).fadeIn(300);
        });
      });

      // Thumbnail slider controls
      const thumbnailSlider = $('.thumbnail-slider');
      const scrollAmount = 150; // Amount to scroll
      $('#prev-slide').on('click', function () {
        thumbnailSlider.animate({ scrollLeft: '-=' + scrollAmount }, 600); // Scroll left
      });
      $('#next-slide').on('click', function () {
        thumbnailSlider.animate({ scrollLeft: '+=' + scrollAmount }, 600); // Scroll right
      });
    });
</script>

