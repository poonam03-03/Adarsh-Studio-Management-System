    <style>

        #card1 {
            margin: 50px auto;
            padding: 60px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15), 0 -4px 10px rgba(0, 0, 0, 0.1), -4px 0 10px rgba(0, 0, 0, 0.1), 4px 0 10px rgba(0, 0, 0, 0.1);
            opacity: 0;
            transform: translateY(50px) scale(0.9);
            transition: all 0.8s ease-out;
        }

            #card1.visible {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

        #timeline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            margin-top: 30px;
            padding: 0 20px;
        }

            #timeline::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 10%;
                right: 10%;
                height: 4px;
                background: #ddd;
                z-index: 1;
                transform: translateY(-50%);
            }

        .step {
            position: relative;
            text-align: center;
            z-index: 2;
            width: 24%;
        }

            .step::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 24px;
                height: 24px;
                background: #fff;
                border: 4px solid #333;
                border-radius: 50%;
                z-index: 3;
                transition: transform 0.3s ease;
            }

            .step:hover::before {
                transform: translate(-50%, -50%) scale(1.4);
                background: maroon;
            }

        #progress-bar {
            position: absolute;
            top: 50%;
            left: 10%;
            height: 4px;
            background: #333;
            z-index: 0;
            transform: translateY(-50%);
            transition: width 0.8s ease-out;
            width: 0;
        }

        .step h5 {
            font-weight: bold;
        }

        .step p {
            margin-top: 35px;
            font-size: 14px;
            color: #555;
        }

