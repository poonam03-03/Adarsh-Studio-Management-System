
@{
    ViewData["Title"] = "PreWedding";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}


    <style>

        .bg-video {
            width: 100%;
            height: 100%; /* Ensuring video fits the container */
            object-fit: cover; /* Covers the full width and height */
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translate(-50%, -60%);
        }

        to {
            opacity: 1;
            transform: translate(-50%, -50%);
        }

        }



        #pre-wedding {
            font-family: 'Arial', sans-serif;
            color: #333;
        }

            #pre-wedding h2 {
                font-size: 2.5rem;
                font-weight: bold;
                color: #5a5a5a;
            }

            #pre-wedding p {
                font-size: 1.2rem;
                line-height: 1.8;
                color: #555;
            }

        #flower {
            height: 100px;
        }



        /*<------------- Second Section ------------> */
        .main-section {
            background-color: #fff5e9;
            padding-bottom: 20px;
        }

        .left-image {
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .left-image img {
                animation: slideInLeft 1.5s ease-in-out;
            }

        .rounded-arch {
            border: 5px solid #f3e0d2;
        }

        .text-section h4 {
            font-size: 20px;
            color: #7a5e54;
        }

        .highlight {
            font-size: 48px;
            color: #e77b56;
            font-weight: bold;
        }

        .subtitle {
            font-size: 16px;
            margin-top: 10px;
            color: #5e4a47;
        }

        .animate-image {
            animation: fadeIn 1.5s ease-in-out;
        }

            @@keyframes slideInLeft {
            from

        {
            transform: translateX(-100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }

        }

            @@keyframes fadeIn {
            from

        {
            opacity: 0;
        }

        to {
            opacity: 1;
        }

        }

        ul {
            list-style-type: disc;
            margin-top: 20px;
            padding-left: 20px;
        }

            ul li {
                font-size: 18px;
                margin-bottom: 10px;
                animation: fadeIn 2s ease-in-out;
            }

        .enquiry-btn {
            display: inline-block;
            margin-top: 50px;
            margin-left: 30px;
            padding: 10px 20px;
            font-size: 18px;
            color: white;
            background-color: #800000;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s ease, transform 0.3s ease;
        }

        .BookNow-btn {
            display: inline-block;
            margin-top: 50px;
            margin-left: 30px;
            padding: 10px 20px;
            font-size: 18px;
            color: white;
            background-color: #800000;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s ease, transform 0.3s ease;
        }

        .enquiry-btn:hover {
            background-color: black;
            transform: scale(1.05);
        }

        .BookNow-btn:hover {
            background-color: black;
            transform: scale(1.05);
        }

        #im2 {
            margin-top: 200px;
        }
            @@media (max-width: 700px) {
            #im2

        {
            margin-top: 15px;
        }

        }

        /* Keyframes for text animation */
            @@keyframes fadeIn {
            to

        {
            opacity: 1;
            transform: translateY(0);
        }

        }


        /* Third Section Candid Info Style Start  */
        .candid-section {
            background-color: #f9f9f9;
            padding: 50px 20px;
            border-radius: 8px;
        }

        .candid-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .candid-header h1 {
                font-size: 36px;
                color: #e77b56;
                font-weight: bold;
            }

        .candid-description {
            font-size: 18px;
            color: #5e4a47;
            margin-bottom: 20px;
        }

        ul {
            list-style-type: disc;
            padding-left: 20px;
            margin-top: 10px;
        }

            ul li {
                font-size: 18px;
                margin-bottom: 10px;
            }

        .lens-section h4 {
            font-size: 22px;
            color: #7a5e54;
            margin-bottom: 10px;
        }

        .images-container img {
            width: 100%;
            margin-bottom: 20px;
        }

        /* Media Query for Mobile */
            @@media (max-width: 768px) {
            .images-container img

        {
            height: auto;
            object-fit: cover;
        }

        }
        /* Third Section Candid Info Style End  */

        /* Fourth Section Card Style Start  */

        .event-card {
            position: relative;
            overflow: hidden;
            border: none;
            height: 350px; /* Fixed card height */
            transition: transform 0.3s;
        }

            .event-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.3s ease, opacity 0.3s ease;
            }

            .event-card:hover img {
                transform: scale(1.1);
                opacity: 0.8; /* Black overlay effect */
            }

            .event-card .icon-overlay {
                display: none; /* Icon removed as per instructions */
            }

        .event-name {
            margin-top: 10px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
            color: #333;
        }

        /* General Section Styling */

    </style>


    <!-- ========== -->
    <section>
        <div class="container-fluid p-0 position-relative">
            <div class="video-overlay"></div>
            <video autoplay muted loop class="bg-video" id="video1">
                <source src="~/videos/pre-weddingvideo.mp4" type="video/mp4">

            </video>
        </div>

    </section>
    <!-- Pre-Wedding Description Section -->
    <section id="pre-wedding" class="py-5 bg-light">
        <div class="container">
            <div class="text-center">
                <img src="~/gallery/rev-flower-1.png" alt="Pre-Wedding Memories" class="img-fluid" id="flower">
                <h2 class="mb-4">Pre-Wedding Memories by Adarsh Studio</h2>
                <p class="mb-3">
                    At Adarsh Studio, we capture the magical moments of your pre-wedding journey with creativity and passion.
                </p>
                <p class="mb-3">
                    Our team specializes in crafting breathtaking shots that reflect your love story.
                </p>
                <p class="mb-3">
                    From serene landscapes to urban backdrops, we provide personalized photography experiences.
                </p>
                <p class="mb-3">
                    Every smile, glance, and emotion is preserved beautifully for you to cherish forever.
                </p>
                <p class="mb-3">
                    Let us make your pre-wedding shoot unforgettable with cinematic excellence and artistic flair.
                </p>
            </div>
        </div>
    </section>


    <!-- Pre-Wedding Description Section -->
    <section id="pre-wedding" class="bg-light">
        <div class="container">
            <div class="row align-items-center">
                <!-- Left Side: Image -->
                <div class="col-sm-6 text-center">
                    <img src="~/gallery/prewed2.jpg" alt="Pre-Wedding Shoot" class="img-fluid">
                </div>

                <!-- Right Side: Content -->
                <div class="col-sm-6">
                    <h2 class="mb-4">Pre-Wedding Memories by Adarsh Studio</h2>
                    <p class="mb-3">
                        Capture your beautiful pre-wedding journey with Adarsh Studio's creative touch. We ensure every moment is cherished forever.
                    </p>
                    <ul class="list-unstyled mb-4">
                        <li>📸 Stunning and personalized photography sessions.</li>
                        <li>🌟 Creative and cinematic shots for your story.</li>
                        <li>🌍 Multiple serene and urban location options.</li>
                        <li>💑 Specialized team to make your moments magical.</li>
                        <li>🎥 High-quality visuals to preserve your memories forever.</li>
                    </ul>
                    <a href="/Adarsh/Booking" class="btn btn-dark btn-lg">Book Now</a>
                </div>
            </div>
        </div>
    </section>


    <!-- Second Section -->
    <div class="container main-section mt-4">
        <div class="row align-items-center">
            <!-- Left Image -->
            <div class="col-lg-3 col-md-12 position-relative left-image">
                <img src="~/gallery/coupleromantic.jpg" alt="Candid Photography" class="img-fluid rounded-arch">
            </div>
            <div class="col-lg-3 col-md-12 position-relative left-image">
                <img src="~/gallery/preweddingcouple.jpg" alt="Candid Photography" class="img-fluid rounded-arch" id="im2">
            </div>
            <!-- Right Content -->
            <div class="col-lg-6 col-md-12 text-section">
                <h4>Welcome to</h4>
                <h1 class="highlight">Adarsh Studio Shankargarh</h1>
                <p class="subtitle">We specialize in candid photography to make your moments unforgettable. Explore our services:</p>
                <ul>
                    <li>Professional Candid Photography for weddings and events.</li>
                    <li>High-quality editing to preserve your precious memories.</li>
                    <li>Specialized in pre-wedding and post-wedding shoots.</li>
                    <li>Creative portraits and family photography.</li>
                    <li>On-demand customized photography solutions.</li>
                </ul>
             
             
            </div>
        </div>
    </div>


    <!-- Third Section Cndid Info -->
    <div class="container candid-section">
        <div class="candid-header">
            <h1>Candid Photography</h1>
            <p class="candid-description">Capturing the most natural and beautiful moments requires skill, patience, and the right equipment. Here's how candid photography is done:</p>
        </div>

        <div class="row">
            <!-- Left Side Content -->
            <div class="col-md-6">
                <ul>
                    <li>Use natural light for more authentic photos.</li>
                    <li>Always stay ready with your camera to capture unexpected moments.</li>
                    <li>Keep your distance to avoid interrupting the natural flow.</li>
                    <li>Use a fast shutter speed to freeze moments.</li>
                    <li>Practice with different angles and perspectives.</li>
                </ul>

                <div class="lens-section">
                    <h4>Recommended Lenses:</h4>
                    <ul>
                        <li><b>50mm f/1.8:</b> Perfect for portraits and low light.</li>
                        <li><b>85mm f/1.4:</b> Ideal for close-up candid shots with great bokeh.</li>
                        <li><b>24-70mm f/2.8:</b> A versatile lens for wider shots and portraits.</li>
                    </ul>
                </div>
            </div>

            <!-- Right Side Images -->
            <div class="col-md-6 images-container">
                <img src="~/gallery/wedding2.png" alt="Candid Photography Image 1">
            </div>
        </div>
    </div>

    <!-- Section: Candid Wedding Smiles -->
    <section class="py-5">
        <div class="container justify-content-center text-center">
            <img src="~/gallery/rev-flower-1.png" alt="Pre-Wedding Memories" class="img-fluid" id="flower">
            <h2 class="text-center mb-4">Natural Candid Moments</h2>
           
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <img src="~/gallery/icecouple.jpg" alt="Wedding Smile 1" class="img-fluid rounded shadow">
                </div>
                <div class="col-sm-6 mb-3">
                    <img src="~/gallery/pre1.jpg" alt="Wedding Smile 1" class="img-fluid rounded shadow">
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <img src="~/gallery/pre2.jpg" alt="Wedding Smile 1" class="img-fluid rounded shadow">
                </div>
                <div class="col-sm-6 mb-3">
                    <img src="~/gallery/pre3.jpg" alt="Wedding Smile 1" class="img-fluid rounded shadow">
                </div>
            </div>
          
        </div>
    </section>


   


