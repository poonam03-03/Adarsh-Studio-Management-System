<script>
    $(document).ready(function () {
        $("#saveenquiry").click(function () {
            var name, mob, email, message;
            name = $("#ename").val().trim();
            email = $("#eemail").val().trim();
            mob = $("#emob").val().trim();
            message = $("#emsg").val().trim();
            // Validation
           if (name === "" || email === "" || mob === "" || message === "") {
            alert("All fields are required!");
            return;
           }
           

           // alert(name + mob + email + subject + message);
           var obj={
               Name: name,
               EmailId: email,
               MobNo: mob,
               QueryMsg: message};
       
               // Disable the button to prevent multiple submissions
               $("#saveenquiry").prop("disabled", true);

           //Ajax Call
            $.ajax({
                type: "POST",
                url: "/Adarsh/SaveEnquiryUsingAJAX",
                data: JSON.stringify(obj),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (result) {
                    alert(result);

                $("#ename").val('');
                $("#eemail").val('');
                $("#emob").val('');
                $("#emsg").val('');

                // Re-enable the button
                $("#saveenquiry").prop("disabled", false);
                },
                error: function(result){
                    alert(result);
                    $("#saveenquiry").prop("disabled", false);  // Re-enable the button
                }
            });
        });


        //Subscription Form
         $('#subscribeform').submit(function(e) {
            e.preventDefault();

            var emailId = $('#semail').val().trim();

            if (emailId === "") {
            alert("Please enter an email address.");
            return;
        }

            $.ajax({
                url: '/Adarsh/Subscribe', // The action method in your controller
                type: 'POST',
                data: { EmailId: emailId },
                success: function(response) {
                    // If email is successfully subscribed
                    if (response.success) {
                        alert('Subscription successful!');
                    } else {
                        // If email already exists
                        alert('This email is already subscribed.');
                    }
                },
                error: function() {
                    alert('An error occurred, please try again later.');
                }
            });
        });

    });
</script>







         




