    <style>
       
        .navbar {
            position: sticky; /* Change to sticky for dynamic top positioning */
            top: 0; /* Ensure it sticks to the top of the viewport */
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1000; /* Ensure it's above other elements */
            background-color: white;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15), 0 -4px 10px rgba(0, 0, 0, 0.1), -4px 0 10px rgba(0, 0, 0, 0.1), 4px 0 10px rgba(0, 0, 0, 0.1);
            font-family: 'Montserrat', sans-serif;
            border-radius: 5px;
            transition: top 0.3s; /* Smooth transition when scrolling */
        }

        .navbar-brand img {
            height: 50px;
            width: auto;
        }

        .nav-link {
            position: relative;
            font-size: 16px;
            font-weight: bold;
            color: #000000;
            transition: color 0.3s ease;
        }

            .nav-link:hover {
                color: #a33838;
            }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 50%;
