
@{
    ViewData["Title"] = "ShowFeedback";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}


@using Adarsh_Studio.Models
@model IEnumerable<FeedbackMaster>
@{
    var StarColors = new string[] { "red", "orange", "yellow", "lightgreen", "green" };
    var Message = new string[] { "Disappointed", "Unsatisfied", "Likely Satisfied", "Satisfied", "Strongly Satisfied" };
}


<style>
   

    .enquiry-section {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .status-pending {
        color: #ffc107;
        font-weight: bold;
    }

    .status-resolved {
        color: #28a745;
        font-weight: bold;
    }

    .action-buttons button {
        margin-right: 5px;
    }
</style>

    <div class="container mt-5">
        <h1 class="text-center mb-4">Manage Feedback</h1>

        <!-- Enquiry Section -->
        <div class="enquiry-section">
            <h4 class="mb-3">Feedback List</h4>
            <p style="color:green;">@TempData["fdelete"] </p>
            <div class="table-responsive">
            <table class="table table-bordered table-hover" id="myTable">
                    <thead class="table-primary">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Feedback Message</th>
                            <th>Ratings</th>
                            <th>Actions</th>
                        </tr>
                    </thead>




                    <tbody>
                        @{

                            foreach (FeedbackMaster em in Model)
                            {
                                <tr>

                                    <td>@em.FeedbackId</td>
                                    <td>@em.Name</td>
                                    <td>@em.MobileNo</td>
                                    <td>@em.EmailId</td>
                                    <td>@em.FeedbackMsg</td>
                                    <td>
                                @for (int i = 0; i < em.StarRating; i++)
                                {
                                    <img src="~/Images/star_icon.png" width="30" height="30" style="background-color: @StarColors[em.StarRating - 1]; border-radius: 50%;" />
                                }
                            
                                </td>
                                    <td>
                                    @* <td>@Html.ActionLink("Edit", "EditRecord", new { id = em.FeedbackId }, new { @class = "btn btn-primary" })</td>*@
                                @Html.ActionLink("Delete", "DeleteFeedback", new { id = em.FeedbackId }, new { @class = "btn btn-danger", @onclick = "return confirmDelete(event, " + em.FeedbackId + ");" })
                                </td>
                                <script type="text/javascript">
                                    function confirmDelete(event, id) {
                                        // Prevent the link from being followed immediately
                                        event.preventDefault();

                                        // Display a confirmation dialog
                                        var isConfirmed = confirm("Are you sure you want to delete this Feedback?");

                                        // If the user confirms, redirect to the DeleteBooking action with the id
                                        if (isConfirmed) {
                                            // Redirect to the DeleteBooking action (you can also submit a form instead if using POST)
                                            window.location.href = '@Url.Action("DeleteFeedback", "Admin", new { id = "__id__" })'.replace('__id__', id);
                                        }
                                    }
                                </script>
                                </tr>

                            }
                        }
                    </tbody>
                </table>


            <button class="btn btn-primary" id="next-button">next</button>
            <button class="btn btn-primary" id="previous-button">Previous</button>
        </div>
    </div>
</div>

<script>
    const rowsPerPage = 5;
    let currentPage = 1;

    function paginate() {
      const startRow = (currentPage - 1) * rowsPerPage;
      const endRow = startRow + rowsPerPage;

      $('#myTable tr').hide().slice(startRow, endRow).show();
    }

    function nextPage() {
      if (currentPage < Math.ceil($('#myTable tr').length / rowsPerPage)) {
        currentPage++;
        paginate();
      }
    }

    function previousPage() {
      if (currentPage > 1) {
        currentPage--;
        paginate();
      }
    }

    paginate();

    $('#next-button').on('click', nextPage);
    $('#previous-button').on('click', previousPage);
</script>