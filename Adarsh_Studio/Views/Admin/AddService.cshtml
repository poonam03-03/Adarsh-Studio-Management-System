


@{
    ViewData["Title"] = "Add Service";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<style>


    .form-control {
        border-radius: 0;
        border: 2px solid black;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border: 2px solid black;
    }

    .input-group {
        margin-bottom: 15px;
    }

    .btn-primary {
        border-radius: 0;
        border: 2px solid black;
    }


    .err {
        color: red;
        font-size: 0.875rem; /* Smaller text size */
        margin-top: 5px; /* Space between the input field and the error message */
        display: block; /* Make it a block element to appear below the input */
    }

    .form-label {
        font-weight: bold;
    }

    span {
        color: red;
    }

    .book-btn {
        background-color: green;
        color: white;
        border: none;
        text-decoration: none;
        padding: 8px 16px;
    }

        .book-btn:hover {
            background-color: #a33838;
        }
</style>




<div class="container my-5">
    <div class="row">
        <h2 class="text-center mb-3" style="color:#a33838;font-weight:bold">Add Staff Member</h2>
        <div class="col-sm-2"></div>

        <div class="col-sm-8 bg-light p-3" style="border:2px solid black;">

            <p class="text-success">@ViewBag.Service</p>


            <!--first row-->
            @using (Html.BeginForm("AddService", "Admin", FormMethod.Post))

            {
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="Name" class="form-label">ServiceType</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-cogs"></i>

                </span>
                            @Html.TextBox("ServiceType", null, new { @class = "form-control", placeholder = "Enter Service Type", id = "ServiceType" })


                        </div>
                        <span id="msg1"></span>

                    </div>

                    <div class="col-md-6">
                        <label for="Contact" class="form-label">Category</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-th-list"></i></span>

                            @Html.TextBox("Category", null, new { @class = "form-control", placeholder = "Enter Category", id = "Category" })

                        </div>
                        <span id="msg2"></span>
                    </div>
                </div>

                <!--second row-->

                <div class="row mb-3">

                    <div class="col-md-6">
                        <label for="exclusions" class="form-label">Budget</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-dollar-sign"></i></span>
                            @Html.TextBox("Budget", null, new { @class = "form-control", placeholder = "Enter Budget", type = "number", id = "Budget" })

                        </div>
                        <span id="msg3"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="exclusions" class="form-label">Discounted Rate</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-percent"></i></span>
                            @Html.TextBox("DiscountedRate", null, new { @class = "form-control", placeholder = "Enter Discounted Rate", type = "number", id = "DiscountedRate" })

                        </div>
                        <span id="msg4"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="Name" class="form-label">Inclusions</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-check-circle"></i></span>
                            @Html.TextBox("Inclusions", null, new { @class = "form-control", placeholder = "Enter Inclusions", id = "Inclusions" })


                        </div>
                        <span id="msg5"></span>

                    </div>

                    <div class="col-md-6">
                        <label for="Contact" class="form-label">Exclusions</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-times-circle"></i></span>

                            @Html.TextBox("Exclusions", null, new { @class = "form-control", placeholder = "Enter Exclusions", id = "Exclusions" })

                        </div>
                        <span id="msg6"></span>
                    </div>
                </div>


                <div class="mb-3">
                    <i class="fas fa-location-dot"></i>
                        <label for="Address" class="form-label">Description</label>
                        @Html.TextArea("Description", null, new { @class = "form-control", placeholder = "Description here...", rows = "4", id = "Description" })
                </div>


                <div class="text-center">
                    <button type="submit"  class="btn book-btn" id="addservicebtn">Add Service</button>
                    <input type="reset" class="btn btn-secondary" value="reset">
                </div>

            }

        </div>


        <div class="col-sm-2"></div>
    </div>
</div>



<!--validation using jquery-->
<script>


               $(document).ready(function(){
               $("#ServiceType").focus();
               //validate of click of submit button
               $("#addservicebtn").click(function(){
                   var result=true;
                   var service,category,description,budget,discount,inclusions,exclusions;
                   //reading values of all input fields
                   service=$("#ServiceType").val().trim();
                   category=$("#Category").val().trim();
                   description=$("#Description").val().trim();
                   budget=$("#Budget").val().trim();
                   discount=$("#DiscountedRate").val().trim();
                   inclusions=$("#Inclusions").val().trim();
                   exclusions=$("#Exclusions").val().trim();


                   //removind past error messages
                   $(".err").remove();
                   //validating name
                   if(service.length==0)
                   {
                       $("#msg1").after("<span class='text-danger'>Please enter Service Type</span>");
                       result=false;
                   }


                   //validate email
                   if(category.length==0)
                   {
                      $("#msg2").after("<span class='err text-danger'>Please enter Category.</span>");
                       result=false;
                   }
                   //validate budget
                   if(budget.length==0)
                   {
                      $("#msg3").after("<span class='err text-danger'>Please enter Budget.</span>");
                       result=false;
                   }
                   else if(budget!=4)
                   {
                      $("#msg3").after("<span class='err text-danger'>Please enter Appropriate Price.</span>");
                       result=false;
                   }

                    if(discount.length==0)
                   {
                      $("#msg4").after("<span class='err text-danger'>Please enter Discounted Rate.</span>");
                       result=false;
                   }
                   else if(discount!=4)
                   {
                      $("#msg4").after("<span class='err text-danger'>Please enter Appropriate Discounted Rate.</span>");
                       result=false;
                   }

                  if(inclusions.length==0)
                  {
                  $("#msg5").after("<span class='err text-danger'>Please enter Inclusions.</span>");
                  result=false;
                  }

                  if(exclusions.length==0)
                  {
                  $("#msg6").after("<span class='err text-danger'>Please enter Exclusions.</span>");
                   result=false;
                  }



                   //validate address
                   if(description.length==0)
                   {
                      $("#Description").after("<span class='err text-danger'>Please enter Description.</span>");
                       result=false;
                   }
                   else{
                  //word count
                  var count=0,x;
                 for( x of msg)
                  {
                 if(x==' ' || x==',' || x=='?' || x=='!')
                    count++;
                 }
                 if(count<8)
                {
                   $("#Description").after("<span class='err'>Please enter Complete Description.</span>");
                 result=false;
                 }
                 }

              // If form is valid, clear all input fields
              if(result) {
              $("#ServiceType").val('');
              $("#Category").val('');
              $("#Description").val('');
              $("#Budget").val('');
              $("#DiscountedRate").val('');
              $("#Inclusions").val('');
              $("#Exclusions").val('');
               }

                   return result;

               });
               });
</script>

