
@{
    ViewData["Title"] = "EditPackage";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}


<style>
    .form-control:focus {
        border-color: #a33838; /* Blue border on focus */
        box-shadow: 0 0 0 0.25rem rgba(38, 143, 255, 0.25); /* Light blue shadow */
    }
</style>

<div class="row">
    <h3 class="text-center text-dark" style="font-weight:bold">Edit Package</h3>
    <div class="col-sm-2"></div>
    <div class="col-sm-8 p-3 bg-light m-3" style="border:2px solid black">
        <p class="text-success">@ViewBag.pmsg</p>
        <form action="EditPackage" method="post">
            <!-- Hidden field to store the package ID -->
            <input type="hidden" name="PackageId" value="@Model.PackageId">

            <div class="mb-3">
                <label class="form-label">Package Title</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-box"></i></span>
                    <input type="text" class="form-control" placeholder="Enter package title" name="PackageTitle" value="@Model.PackageTitle" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Package Price</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                    <input type="number" class="form-control" placeholder="Enter package price" name="Price" value="@Model.Price" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Package Details 1</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                    <input type="text" class="form-control" placeholder="Enter package details" name="Detail1" value="@Model.Detail1">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Package Details 2</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                    <input type="text" class="form-control" placeholder="Enter package details" name="Detail2" value="@Model.Detail2">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Package Details 3</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                    <input type="text" class="form-control" placeholder="Enter package details" name="Detail3" value="@Model.Detail3">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Package Details 4</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                    <input type="text" class="form-control" placeholder="Enter package details" name="Detail4" value="@Model.Detail4">
                </div>
            </div>

            <button type="submit" class="btn btn-dark">Update</button>
            <button type="reset" class="btn btn-secondary">Clear all</button>
        </form>
    </div>
    <div class="col-sm-2"></div>
</div>

