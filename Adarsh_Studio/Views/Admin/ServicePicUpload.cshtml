
@{
    ViewData["Title"] = "ServicePicUpload";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<div class="row">
    <div class="col-sm-3"></div>
    <div class="col-sm-6">
        @using(Html.BeginForm("ServicePicUpload","Admin",FormMethod.Post,new{enctype="multipart/form-data"}))
        {
            <label>Task related with Topic?</label>
            <input type="text" class="form-control" name="title" />
            <label for=" description">Description of Task</label>
            <textarea name="Description" class="form-control" rows="4"></textarea><br />
            <span name="File" class="form-control">
                <input type="file" name="TaskFile" />
            </span>
            <br />
            <input type="submit" value="Submit" class="btn btn-success" />
        }
    </div>
</div>

