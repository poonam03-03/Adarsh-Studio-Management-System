
@{
    ViewData["Title"] = "ShowService";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}




@model IEnumerable<Adarsh_Studio.Models.ServiceMaster>

<style>

  
   

    .enquiry-section {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .status-pending {
        color: #ffc107;
        font-weight: bold;
    }

    .status-resolved {
        color: #28a745;
        font-weight: bold;
    }

    .action-buttons button {
        margin-right: 5px;
    }

    .service-image {
        max-width: 100px; /* Limit image size */
        max-height: 100px;
    }

   
</style>


<div class="container mt-5">
    <h1 class="text-center mb-4">📨 Manage Service</h1>

    <!-- Enquiry Section -->
    <div class="enquiry-section">
        <h4 class="mb-3">Service List</h4>
        <p class="text-success">@TempData["imageupload"]</p>
        <p class="text-success">@TempData["sdelete"] </p>
        <p class="text-success">@TempData["serviceedit"]</p>
       <p class="text-success">@TempData["ErrorMessage"]</p>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>Service Id</th>
                        <th>Service Name</th>
                        <th>Description</th>  
                        <th>Budget</th>
                        <th>Images</th>
                        <th>Upload Image</th>
                        <th colspan="2">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        foreach (ServiceMaster em in Model)
                        {
                            <tr>

                                <td>@em.ServiceId</td>
                                <td>@em.ServiceType</td>
                                <td>@em.Description</td>
                                <td>@em.Budget</td>

                                <td>
                                    @foreach (var pic in em.ServicePicMasters)
                                    {
                                        <img src="@Url.Content("~/Uploads/" + "/"+pic.PicFileName)" alt="Service Image" class="service-image" />
                                    }
                                </td>
                                <td>@Html.ActionLink("Upload Image","UploadServiceImage", new { serviceId = em.ServiceId },new{@class="btn btn-success"})</td>
                                <td>@Html.ActionLink("Edit", "EditService", new { id = em.ServiceId }, new { @class = "btn btn-primary" })
                                    @Html.ActionLink("Delete", "DeleteService", new { id = em.ServiceId }, new { @class = "btn btn-danger", @onclick = "return confirmDelete(event, " + em.ServiceId + ");" })
                                </td>
                                <script type="text/javascript">
                                    function confirmDelete(event, id) {
                                        // Prevent the link from being followed immediately
                                        event.preventDefault();

                                        // Display a confirmation dialog
                                        var isConfirmed = confirm("Are you sure you want to delete this Service?");

                                        // If the user confirms, redirect to the DeleteBooking action with the id
                                        if (isConfirmed) {
                                            // Redirect to the DeleteBooking action (you can also submit a form instead if using POST)
                                            window.location.href = '@Url.Action("DeleteService", "Admin", new { id = "__id__" })'.replace('__id__', id);
                                        }
                                    }
                                </script>
                                
                            </tr>

                        }
                    }
                </tbody>
            </table>


            <button class="btn btn-primary" id="next-button">next</button>
            <button class="btn btn-primary" id="previous-button">Previous</button>
        </div>
    </div>
</div>

<script>
    const rowsPerPage = 5;
    let currentPage = 1;

    function paginate() {
      const startRow = (currentPage - 1) * rowsPerPage;
      const endRow = startRow + rowsPerPage;

      $('#myTable tr').hide().slice(startRow, endRow).show();
    }

    function nextPage() {
      if (currentPage < Math.ceil($('#myTable tr').length / rowsPerPage)) {
        currentPage++;
        paginate();
      }
    }

    function previousPage() {
      if (currentPage > 1) {
        currentPage--;
        paginate();
      }
    }

    paginate();

    $('#next-button').on('click', nextPage);
    $('#previous-button').on('click', previousPage);
</script>

