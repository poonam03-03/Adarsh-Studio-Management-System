
@{
    ViewData["Title"] = "ShowCity";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}



@using Adarsh_Studio.Models
@model IEnumerable<CityMaster>


<style>
    body {
        background-color: #f8f9fa;
        font-family: Arial, sans-serif;
    }

    .enquiry-section {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .status-pending {
        color: #ffc107;
        font-weight: bold;
    }

    .status-resolved {
        color: #28a745;
        font-weight: bold;
    }

    .action-buttons button {
        margin-right: 5px;
    }
</style>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Manage Cities</h1>

        <!-- Enquiry Section -->
        <div class="enquiry-section">
            <h4 class="mb-3">City List</h4>
            <p class="text-success">@TempData["cityedit"]</p>
        <p class="text-success"> @TempData["cdelete"]</p>
            <div class="table-responsive">
            <table class="table table-bordered table-hover" id="myTable">
                    <thead class="table-primary">
                        <tr>
                            <th>Id</th>
                            <th>City Name</th>                          
                            <th colspan="2">Actions</th>
                        </tr>
                    </thead>




                    <tbody>
                        @{
                            foreach (CityMaster em in Model)
                            {
                                <tr>

                                    <td>@em.CityId</td>
                                    <td>@em.CityName</td>
                                   
                                    <td>@Html.ActionLink("Edit", "EditCity", new { id = em.CityId }, new { @class = "btn btn-primary" })
                                    @Html.ActionLink("Delete", "DeleteCity", new { id = em.CityId }, new { @class = "btn btn-danger", @onclick = "return confirmDelete(event, " + em.CityId + ");" })
                                </td>
                                <script type="text/javascript">
                                    function confirmDelete(event, id) {
                                        // Prevent the link from being followed immediately
                                        event.preventDefault();

                                        // Display a confirmation dialog
                                        var isConfirmed = confirm("Are you sure you want to delete this City?");

                                        // If the user confirms, redirect to the DeleteBooking action with the id
                                        if (isConfirmed) {
                                            // Redirect to the DeleteBooking action (you can also submit a form instead if using POST)
                                            window.location.href = '@Url.Action("DeleteCity", "Admin", new { id = "__id__" })'.replace('__id__', id);
                                        }
                                    }
                                </script>
                                </tr>

                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>



